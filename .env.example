# Without SESSION_SECRET the whole app fails: every page 500s with
# "SESSION_SECRET is missing or too short".
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET=replace-with-a-random-string-at-least-32-chars

# Optional plug-in: broker connections (Settings → Advanced).
# Dedicated AES-GCM key for encrypting linked broker passwords at rest.
# Without it, broker linking is disabled (test/save throw a clear error).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
BROKER_VAULT_SECRET=replace-with-another-random-string-at-least-32-chars

# API base URLs (server-only, never bundled to the client).
CDSC_BASE_URL=
CDSC_ORIGIN_URL=
YONEPSE_BASE_URL=
NEPSE_API_URL=
GITHUB_REPO_URL=
GITHUB_API_RELEASES_URL=

# Naasa broker URLs (server-only).
NAASA_BASE_URL=
NAASA_AUTH_URL=
NAASA_WALLET_URL=
